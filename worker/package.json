{
  "name": "urbancart-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create urbancart",
    "db:migrate:local": "wrangler d1 migrations apply urbancart --local",
    "db:migrate:remote": "wrangler d1 migrations apply urbancart --remote",
    "db:seed:local": "wrangler d1 execute urbancart --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute urbancart --remote --file=./migrations/0002_seed.sql",
    "types": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.8.12",
    "jose": "^6.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.26.0"
  }
}
